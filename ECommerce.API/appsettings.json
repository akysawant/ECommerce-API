{
  "ConnectionStrings": {
    "DefaultConnection": "server=localhost;port=3306;database=ecommercedb;user=root;password=YourPassword;",
    "ECommerceDbContext": "Server=(localdb)\\mssqllocaldb;Database=ECommerceDbContext;Trusted_Connection=True;MultipleActiveResultSets=true"
  },

  "JwtSettings": {
    "Key": "ReplaceWithYourSecretKey",
    "Issuer": "ECommerce.API",
    "Audience": "ECommerce.Client",
    "ExpiryInMinute": 60
  },

  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "YourEmailAddress"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}